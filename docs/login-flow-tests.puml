@startuml
title login flow and test branches

start
:Client submits username and password;
:HTTP /login handler builds LoginRequest;
:LoginService loads auth account by username;

if (Auth account found?) then (yes)
  if (Account locked?) then (yes)
    :Return AccountLocked;
    :HTTP 403 + error body;
    stop
  else (no)
  endif

  if (Password matches?) then (yes)
    if (Self-excluded?) then (yes)
      :Return SelfExcluded;
      :HTTP 403 + error body;
      stop
    else (no)
      :Return success;
      :HTTP 200 + success body;
      stop
    endif
  else (no)
    :Return InvalidCredentials;
    :HTTP 401 + error body;
    stop
  endif
else (no)
  :Return InvalidCredentials;
  :HTTP 401 + error body;
  stop
endif

@enduml
